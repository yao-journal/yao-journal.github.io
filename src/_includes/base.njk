<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.intro }}">
  <link rel="stylesheet" href="/assets/lxgw/lxgwwenkai-regular.css">
  <link rel="stylesheet" href="/assets/lxgw/lxgwwenkai-bold.css">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <header class="masthead">
    <a class="sitename" href="/">{{ site.title }}</a>
    <nav>
      <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>首页<span>HOME</span></a>
      <a href="/diary/" {% if (page.url or "").startsWith("/diary/") %}aria-current="page"{% endif %}>日记<span>DIARY</span></a>
      <a href="/travel/" {% if (page.url or "").startsWith("/travel/") %}aria-current="page"{% endif %}>旅行<span>TRAVEL</span></a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="foot">© {{ "now" | year }} {{ site.title }}</footer>
</body>
</html>
