---
layout: base.njk
---
<article class="entry trip">
  <header class="entry-head">
    <h1>{{ title }}</h1>
    <p class="entry-meta">
      <time datetime="{{ date | isoDate }}">{{ date | dotDate }}</time>
      {% if place %}<span>{{ place }}</span>{% endif %}
    </p>
  </header>
  {% if cover %}<figure class="trip-cover"><img src="{{ cover }}" alt="{{ title }}"></figure>{% endif %}
  {% if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}
  {% include "sections.njk" %}
  {% if photos and photos.length %}
  <div class="photos">
    {% for src in photos %}<img src="{{ src }}" alt="">{% endfor %}
  </div>
  {% endif %}
  <p class="back"><a href="/travel/">全部旅行<span>ALL TRAVEL</span></a></p>
</article>
