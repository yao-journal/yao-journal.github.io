{#- 方形格子：有照片显示照片，没有照片显示日期和标题 -#}
{%- set img = item.data.cover or (item.content | firstImage) -%}
<li class="tile{% if not img %} tile--text{% endif %}">
  <a href="{{ item.url }}">
    {% if img %}<img src="{{ img }}" alt="{{ item.data.title }}">{% endif %}
    <span class="tile-cap">
      <span class="tile-date">{{ item.date | dotDate }}</span>
      <span class="tile-title">{{ item.data.title }}</span>
    </span>
  </a>
</li>
